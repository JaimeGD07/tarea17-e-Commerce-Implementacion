# URL base de la API Laravel (Tarea 12). Debe incluir el prefijo /api y NO terminar en "/".
# Solo la usa el servidor de Next.js (Server Components y Server Actions), nunca el navegador.
API_BASE_URL=http://localhost:8030/api

# Clave PUBLICA de Stripe (modo test). Es la unica variable expuesta al navegador.
# La clave secreta (sk_test_...) vive solo en el .env de la API Laravel.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
